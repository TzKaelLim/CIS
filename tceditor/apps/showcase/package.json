    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-custom": "workspace:*",
    "jest": "29.7.0",
    "tailwindcss": "4.3.3",
    "ts-jest": "29.4.9",
    "ts-node": "10.9.2",

      "deprecated": false,
      "props": {
        "type": "object",
        "properties": {
          "text": {
            "default": "標題文字",
            "title": "標題文字",
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "level": {
            "default": "h2",
            "title": "層級",
            "x-labels": {
              "h1": "標題 1",
              "h2": "標題 2",
              "h3": "標題 3",
              "h4": "標題 4"

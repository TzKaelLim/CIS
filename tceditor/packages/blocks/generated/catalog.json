            "type": "string",
            "enum": [
              "h1",
              "h2",
              "h3",
              "h4"
            ]
          },
          "align": {
            "default": "start",
            "title": "對齊",
            "x-labels": {
              "start": "靠左",
              "center": "置中",
              "end": "靠右"
            },
            "type": "string",
            "enum": [
              "start",
              "center",
              "end"
            ]
          }
        },
        "additionalProperties": false
      },
      "slots": {},
      "examples": [
        {
          "name": "只用預設值",
          "props": {}
        },
        {
          "name": "置中的頁面主標題",

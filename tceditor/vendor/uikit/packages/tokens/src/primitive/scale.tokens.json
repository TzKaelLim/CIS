{
  "space": {
    "$type": "dimension",
    "4": { "$value": "4px" },
    "8": { "$value": "8px" },
    "12": { "$value": "12px" },
    "16": { "$value": "16px" },
    "20": { "$value": "20px" },
    "24": { "$value": "24px" },
    "32": { "$value": "32px" },
    "40": { "$value": "40px" },
    "48": { "$value": "48px" },
    "64": { "$value": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0" },
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "16px" },
    "full": { "$value": "9999px" }
  },
  "size": {
    "icon": {
      "$type": "dimension",
      "sm": { "$value": "20px" },
      "md": { "$value": "32px" },
      "lg": { "$value": "40px" }
    },
    "control": {
      "$type": "dimension",
      "md": { "$value": "48px" },
      "lg": { "$value": "64px" }
    }
  },
  "opacity": {
    "$type": "number",
    "disabled": { "$value": 0.38 },
    "hover-overlay": { "$value": 0.08 }
  },
  "focus-ring": {
    "color": { "$type": "color", "$value": "{color.blue.500}" },
    "width": { "$type": "dimension", "$value": "2px" },
    "offset": { "$type": "dimension", "$value": "2px" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "150ms" },
      "base": { "$value": "200ms" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
    }
  },
  "z": {
    "$type": "number",
    "base": { "$value": 0 },
    "dropdown": { "$value": 1000 },
    "sticky": { "$value": 1100 },
    "overlay": { "$value": 1200 },
    "modal": { "$value": 1300 },
    "popover": { "$value": 1400 },
    "toast": { "$value": 1500 }
  },
  "breakpoint": {
    "$type": "dimension",
    "mobile": { "$value": "375px" },
    "tablet": { "$value": "768px" },
    "desktop": { "$value": "1024px" },
    "wide": { "$value": "1920px" }
  },
  "container": {
    "$type": "dimension",
    "sm": { "$value": "375px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px" },
    "full": { "$value": "1920px" }
  }
}

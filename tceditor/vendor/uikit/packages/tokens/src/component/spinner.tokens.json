{
  "spinner": {
    "size-sm": { "$type": "dimension", "$value": "{size.icon.sm}" },
    "size-md": { "$type": "dimension", "$value": "{size.icon.md}" },
    "size-lg": { "$type": "dimension", "$value": "{size.icon.lg}" },
    "color": { "$type": "color", "$value": "{color.brand.primary}" },

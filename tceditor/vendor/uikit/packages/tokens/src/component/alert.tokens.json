{
  "alert": {
    "accent-info": { "$type": "color", "$value": "{color.feedback.info}" },
    "accent-success": { "$type": "color", "$value": "{color.feedback.success}" },
    "accent-warning": { "$type": "color", "$value": "{color.feedback.warning}" },
    "accent-danger": { "$type": "color", "$value": "{color.feedback.error}" },
    "title-fg": { "$type": "color", "$value": "{color.text.default}" },
    "text-fg": { "$type": "color", "$value": "{color.text.default}" },
    "radius": { "$type": "dimension", "$value": "{radius.md}" },
    "padding": { "$type": "dimension", "$value": "{space.16}" },
    "gap": { "$type": "dimension", "$value": "{space.12}" },
    "icon-size": { "$type": "dimension", "$value": "{size.icon.sm}" },
    "dismiss-fg": { "$type": "color", "$value": "{color.text.muted}" }
  }
}

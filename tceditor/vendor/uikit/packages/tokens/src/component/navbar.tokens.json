{
  "navbar": {
    "bg": {
      "$type": "color",
      "$value": "{color.surface.default}"
    },
    "fg": {
      "$type": "color",
      "$value": "{color.text.default}"
    },
    "border": {
      "$type": "color",
      "$value": "{color.border.default}"
    },
    "height": {
      "$type": "dimension",
      "$value": "{size.control.lg}"
    },
    "padding-inline": {
      "$type": "dimension",
      "$value": "{space.24}"
    },
    "item-gap": {
      "$type": "dimension",
      "$value": "{space.24}"
    },
    "drawer-bg": {
      "$type": "color",
      "$value": "{color.surface.default}"
    },
    "drawer-elevation": {
      "$type": "shadow",
      "$value": "{elevation.2}"
    },
    "toggle-bg-hover": {
      "$type": "color",
      "$value": "{color.brand.surface}"
    },
    "focus-ring-color": {
      "$type": "color",
      "$value": "{color.border.focus}"
    }
  }
}

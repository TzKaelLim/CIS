{
  "input": {
    "bg": { "$type": "color", "$value": "{color.surface.default}" },
    "border": { "$type": "color", "$value": "{color.border.default}" },
    "border-hover": { "$type": "color", "$value": "{color.border.focus}" },
    "border-focused": { "$type": "color", "$value": "{color.border.focus}" },
    "border-invalid": { "$type": "color", "$value": "{color.feedback.error}" },
    "focus-ring": { "$type": "color", "$value": "{color.brand.surface-hover}" },
    "radius": { "$type": "dimension", "$value": "{radius.md}" },
    "text": { "$type": "color", "$value": "{color.text.default}" },
    "placeholder": { "$type": "color", "$value": "{color.text.muted}" },
    "disabled-opacity": { "$type": "number", "$value": "{opacity.disabled}" }
  }
}

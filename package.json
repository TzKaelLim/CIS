{
  "name": "tzuchi-uikit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build --filter='!./heroui/*'",
    "typecheck": "tsc -b",
    "test": "turbo run test --filter='!./heroui/*'",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "verify:pkg": "turbo run verify:pkg --filter='!./heroui/*'",
    "changeset": "changeset",
    "heroui:theme": "node heroui/styles/themes/tzuchi/generate.mjs",
    "heroui:storybook": "pnpm --filter @heroui/storybook exec storybook dev --host 127.0.0.1 --port 6007 --no-open",
    "heroui:storybook:build": "pnpm --filter @heroui/storybook build"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "turbo": "^2.3.0",
    "@changesets/cli": "^2.27.0",
    "eslint": "^9.13.0",
    "@eslint/js": "^9.13.0",
    "typescript-eslint": "^8.13.0",
    "prettier": "^3.3.0",
    "publint": "^0.2.12",
    "@arethetypeswrong/cli": "^0.18.0"
  }
}

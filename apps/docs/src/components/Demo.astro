---
// Live example wrapper. The client <script> registers every <tc-*> element,
// so the slotted custom elements below are real, interactive components —
// not screenshots. Same CDN source as production.
---

<div class="tc-demo not-content">
  <slot />
</div>

<script>
  import '@tzuchi/components';
</script>

<style>
  .tc-demo {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    padding: 1.5rem;
    /* Use the design-system surface so the demo canvas matches the active
       theme (light/dark) the components themselves render for. */
    border: 1px solid var(--tc-color-border-default, var(--sl-color-gray-5));
    border-radius: 0.5rem;
    background: var(--tc-color-surface-default, var(--sl-color-gray-7, #fff));
    color: var(--tc-color-text-default, inherit);
  }
  /* Keep wide examples inside the box on narrow screens, so they never make the
     whole page scroll sideways: fixed-width fields shrink to the box, and rows
     that never wrap (tabs, pagination) scroll inside their own element. The box
     itself keeps overflow visible, so an opened dropdown list is not clipped. */
  .tc-demo > :global(*) {
    max-inline-size: 100%;
  }
  .tc-demo :global(:is(tc-tabs, tc-pagination)) {
    overflow-x: auto;
  }
</style>

---
// 取代 Starlight 的側欄。側欄的內容已經在 src/route-data.ts 換成「只有目前區域」；
// 這裡另外加上：
// - 手機選單最上方的區域導覽（首頁／文件／元件／範本／網站主題），桌機寬度不顯示，
//   因為頁首已經有了。
// - 「元件」區域的「搜尋元件…」篩選框：輸入時即時篩選下方清單。需要 JavaScript，
//   所以預設隱藏，script 執行後才顯示。
// - 手機選單最下方：網站主題的下拉選單（MobileMenuFooter，見 ThemeSelect.astro），
//   以及頁首在手機寬度放不下的「開始使用」和 GitHub 連結。色彩模式在頁首的圓形按鈕。
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import SectionNav from '../handbook/SectionNav.astro';
import HeaderIcon from '../handbook/HeaderIcon.astro';
import { sectionForPath } from '../../data/sections';
import { REPOSITORY_URL } from '../../data/repository';

const { sidebar } = Astro.locals.starlightRoute;
const section = sectionForPath(Astro.url.pathname);
const filterId = 'tc-sidebar-filter-input';
// 清單由好幾個分類組成（例如元件區域）時，分類裡的項目就是主要的連結；
// 只有一個子群組（例如「基礎 Foundations」）時，子群組裡的項目小一號（見 handbook.css）。
const grouped = sidebar.filter((entry) => entry.type === 'group').length > 1;
---

<div class:list={['md:sl-hidden mobile-sections', { divided: sidebar.length > 0 }]}>
  <SectionNav variant="menu" />
</div>

{
  section.id === 'components' && (
    <tc-sidebar-filter class="filter" hidden>
      <label class="sr-only" for={filterId}>
        搜尋元件
      </label>
      <span class="filter-box">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
          <path d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5Zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14Z" />
        </svg>
        <input
          id={filterId}
          type="search"
          placeholder="搜尋元件…"
          autocomplete="off"
          spellcheck="false"
        />
      </span>
      <p class="filter-status" role="status" aria-live="polite"></p>
    </tc-sidebar-filter>
  )
}

{
  sidebar.length > 0 && (
    <div class:list={['section-list', { grouped }]} data-tc-sidebar-list>
      <SidebarPersister>
        <SidebarSublist sublist={sidebar} />
      </SidebarPersister>
    </div>
  )
}

<div class="md:sl-hidden mobile-footer">
  <MobileMenuFooter />
  <p class="mobile-actions">
    <a class="hb-pill" href="/docs/">開始使用</a>
    <a
      class="github"
      href={REPOSITORY_URL}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub repository"
    >
      <HeaderIcon name="github" />
      <span>GitHub</span>
    </a>
  </p>
</div>

<script>
  /** 比對用：忽略大小寫和空白。 */
  const normalize = (text: string): string => text.toLowerCase().replace(/\s+/g, '');

  class TcSidebarFilter extends HTMLElement {
    connectedCallback() {
      const input = this.querySelector<HTMLInputElement>('input');
      const status = this.querySelector<HTMLElement>('.filter-status');
      const list = document.querySelector<HTMLElement>('[data-tc-sidebar-list]');
      if (!input || !status || !list) return;
      this.hidden = false;

      const apply = () => {
        const query = normalize(input.value);
        let matches = 0;
        // 每個群組（分類）：名稱符合就整組顯示，否則只顯示符合的元件。
        list.querySelectorAll<HTMLLIElement>('li').forEach((li) => {
          li.hidden = false;
        });
        const groups = list.querySelectorAll<HTMLDetailsElement>('details');
        groups.forEach((details) => {
          const groupLabel = details.querySelector('summary')?.textContent ?? '';
          const groupMatches = query !== '' && normalize(groupLabel).includes(query);
          let shown = 0;
          details.querySelectorAll<HTMLAnchorElement>(':scope > ul > li > a').forEach((a) => {
            const visible = query === '' || groupMatches || normalize(a.textContent ?? '').includes(query);
            const li = a.closest('li');
            if (li) li.hidden = !visible;
            if (visible) shown += 1;
          });
          const groupLi = details.closest('li');
          if (groupLi) groupLi.hidden = shown === 0;
          if (query !== '' && shown > 0) details.open = true;
          matches += query === '' ? 0 : shown;
        });
        // 不在群組裡的連結（例如「總覽」）。
        list.querySelectorAll<HTMLAnchorElement>('.top-level > li > a').forEach((a) => {
          const visible = query === '' || normalize(a.textContent ?? '').includes(query);
          const li = a.closest('li');
          if (li) li.hidden = !visible;
          if (visible && query !== '') matches += 1;
        });
        status.textContent =
          query === '' ? '' : matches > 0 ? `找到 ${matches} 個元件` : '沒有符合的元件';
      };

      input.addEventListener('input', apply);
      input.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && input.value !== '') {
          input.value = '';
          apply();
        }
      });
      // 從「上一頁」回來時，瀏覽器可能保留輸入框的文字。
      if (input.value !== '') apply();
    }
  }

  customElements.define('tc-sidebar-filter', TcSidebarFilter);
</script>

<style>
  /* 下面還有清單時才畫分隔線；首頁只有偏好設定，它自己有上框線。 */
  .mobile-sections.divided {
    padding-block-end: 0.75rem;
    border-block-end: 1px solid var(--sl-color-hairline);
  }
  .filter {
    display: block;
  }
  .filter[hidden] {
    display: none;
  }
  .filter-box {
    position: relative;
    display: flex;
    align-items: center;
  }
  .filter-box svg {
    position: absolute;
    inset-inline-start: 0.7rem;
    color: var(--sl-color-gray-3);
    pointer-events: none;
  }
  input {
    inline-size: 100%;
    padding: 0.5rem 0.75rem 0.5rem 2.1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.6rem;
    background-color: var(--sl-color-black);
    color: var(--sl-color-white);
    font: inherit;
    font-size: var(--hb-text-ui);
  }
  input::placeholder {
    color: var(--sl-color-gray-3);
  }
  input:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
  }
  /* 結果訊息的區塊一直都在（螢幕閱讀器才會唸出變化），沒有文字時不佔空間。 */
  .filter-status {
    margin: 0;
    color: var(--sl-color-gray-3);
    font-size: var(--hb-text-label);
  }
  .filter-status:not(:empty) {
    margin-block-start: 0.5rem;
  }
  .mobile-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0 0 1rem;
    padding-block-start: 0.75rem;
    border-block-start: 1px solid var(--sl-color-hairline);
  }
  .github {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-block-size: 2.5rem;
    color: var(--sl-color-white);
    font-size: var(--hb-text-ui);
    font-weight: 500;
    text-decoration: none;
  }
  .github:hover {
    text-decoration: underline;
  }
  .github:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
</style>

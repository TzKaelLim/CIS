---
// 元件頁「在目前網站主題下的樣子」的共用內容（R-H-08 第 5 段）：
// 先是「目前顯示：<網站名>」那一行，再寫出目前這個網站的預設變體，以及和預設網站不同的地方。
// 每個網站各畫一份，只顯示頁首選的那一個（SiteOnly），所以網站再多，頁面也只有一份內容。
//
// 和預設網站不同的地方由 src/data/site-themes.ts 算出來（只有語意色）；各網站的預設變體要等
// 網站設定檔（R-D-24，提案，尚未實作），在那之前每個網站都用元件本身的預設變體。
import CurrentSiteNote from './CurrentSiteNote.astro';
import SiteOnly from './SiteOnly.astro';
import { DEFAULT_SITE, SITE_THEMES, sitePageUrl, tokenLabel } from '../../data/site-themes';
---

<CurrentSiteNote />

{
  SITE_THEMES.map((site) => (
    <SiteOnly site={site.id}>
      <ul class="site-look">
        <li>
          <strong>預設變體：</strong>
          {site.isDefault
            ? '用元件本身的預設變體。'
            : `和${DEFAULT_SITE.名稱}一樣，用元件本身的預設變體（各網站自己的預設變體要等網站設定檔，還沒有實作）。`}
        </li>
        <li>
          <strong>和預設網站不同的地方：</strong>
          {site.isDefault ? (
            '沒有。這就是預設網站主題，其他網站沒有特別指定的地方都沿用它。'
          ) : site.changed.length === 0 ? (
            '沒有，全部沿用預設網站主題。'
          ) : (
            <>
              只有顏色：{site.changed.map(tokenLabel).join('、')}
              {site.isDemo && '（示意值，非正式）'}。用到這些顏色的部分會變，其餘和預設網站一樣。
              <a href={sitePageUrl(site)}>看完整的顏色對照</a>
            </>
          )}
        </li>
      </ul>
    </SiteOnly>
  ))
}

<style>
  .site-look {
    margin-block: 0.75rem 1rem;
  }
</style>

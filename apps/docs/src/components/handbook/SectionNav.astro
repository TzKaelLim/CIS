---
// 手冊的區域導覽：文件／元件／範本／網站主題，最後是 Storybook。目前所在的區域會被標示出來。
// 頁首用 variant="header"（橫排）；手機選單用 variant="menu"（直排，多一個「首頁」）。
// Storybook 不是手冊的區域：永遠不標示為目前區域。它是另一個網站，本機預覽時找不到頁面
// （說明在 /docs/ 的「給工程師」和元件總覽）。
import { HOME, SECTIONS, isSectionHome, sectionForPath } from '../../data/sections';
import { STORYBOOK_HREF } from '../../data/repository';

interface Props {
  variant?: 'header' | 'menu';
}

const { variant = 'header' } = Astro.props;
const pathname = Astro.url.pathname;
const current = sectionForPath(pathname);
const items = variant === 'menu' ? [HOME, ...SECTIONS] : SECTIONS;
---

<nav class:list={['section-nav', variant]} aria-label="手冊區域">
  <ul>
    {
      items.map((section) => {
        const isCurrent = section.id === current.id;
        // 區域入口頁本身是「目前頁面」；區域裡的其他頁只標示「目前區域」。
        const ariaCurrent = isCurrent
          ? isSectionHome(section, pathname)
            ? 'page'
            : 'true'
          : undefined;
        return (
          <li>
            <a href={section.href} aria-current={ariaCurrent}>
              {section.label}
            </a>
          </li>
        );
      })
    }
    <li class="storybook">
      <a href={STORYBOOK_HREF}>Storybook</a>
    </li>
  </ul>
</nav>

<style>
  /* 頁首：每個連結 32px 高、14px、圓角 12px，彼此相隔 4px；目前區域用粗一點的深色字，
     不加底色；滑鼠移上時才有淡淡的底色。 */
  ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: block;
    padding: 0.375rem 0.75rem;
    border-radius: 12px;
    color: var(--sl-color-gray-2);
    font-size: var(--hb-text-ui);
    font-weight: 500;
    line-height: 1.25rem;
    text-decoration: none;
    white-space: nowrap;
  }
  a:hover {
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-6);
  }
  a[aria-current] {
    color: var(--sl-color-white);
    font-weight: 600;
  }
  /* 中等寬度（50rem 到 60rem）：連結的左右內距縮小；放不下時先藏起 Storybook（見 Header.astro）。 */
  @media (min-width: 50rem) and (max-width: 59.99rem) {
    .header a {
      padding-inline: 0.5rem;
    }
  }
  a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  /* 手機選單：直排、整列可點，目前區域用品牌色標示。 */
  .menu ul {
    flex-direction: column;
    gap: 0.125rem;
  }
  .menu a {
    padding: 0.65rem 0.75rem;
    border-radius: 0.6rem;
    font-size: var(--hb-text-ui);
    font-weight: 400;
    line-height: var(--hb-line-height-ui);
  }
  .menu a[aria-current] {
    font-weight: 600;
    color: var(--sl-color-accent-high);
    background-color: var(--sl-color-accent-low);
  }
</style>

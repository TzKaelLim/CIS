---
// 網站主題總覽頁上方的「左邊清單、右邊大樣本」。
//
// - 左邊：每個網站主題一張卡片（名稱、預設／示意標籤、淺色與深色的關鍵色）。點卡片 = 用 ?site=<id>
//   套用那個網站主題；目前選擇的卡片有外框和「目前選擇」標記（規則由 site-selection.ts 產生）。
//   清單很長（例如 20 個網站）時，在桌機寬度自己捲動，不會把右邊的樣本推走。
// - 右邊：入口首頁範本放大顯示，只畫一份，顏色跟著頁首目前選的網站主題和色彩模式。
// - 窄螢幕：清單在上（同樣有最大高度、可捲動），樣本在下。
import { Badge } from '@astrojs/starlight/components';
import SiteOnly from './SiteOnly.astro';
import TemplateFrame from './TemplateFrame.astro';
import {
  MODES,
  MODE_LABEL,
  SITE_THEMES,
  siteLabel,
  sitePageUrl,
  type TokenName,
} from '../../data/site-themes';
import { SITE_URL_PARAM } from '../../data/site-selection';
import { getTemplate, templateUrl } from '../../data/template-catalog';

const KEY_COLORS: { label: string; token: TokenName }[] = [
  { label: '主色', token: 'brand.primary' },
  { label: '品牌底色', token: 'brand.surface' },
  { label: '背景', token: 'surface.default' },
];
const sample = getTemplate('portal-home');
---

<div class="tc-theme-browser not-content">
  <section class="list-panel" aria-labelledby="tc-theme-list-title">
    <div class="list-head">
      <h2 id="tc-theme-list-title">所有網站主題</h2>
      <p>
        目前有 {SITE_THEMES.length} 個。點一個網站主題，樣本和手冊裡所有的元件、範本都會換成那個網站的顏色；頁首的「網站主題」選單也可以切換。
      </p>
    </div>
    <ul class="sites">
      {
        SITE_THEMES.map((site) => (
          <li class="site" data-site-card={site.id}>
            <div class="site-head">
              <a class="apply" href={`?${SITE_URL_PARAM}=${site.id}`}>
                {site.名稱}
                <span class="sr-only">：套用這個網站主題</span>
              </a>
              {site.isDefault && <Badge text="預設" variant="note" />}
              {site.isDemo && <Badge text="示意" variant="caution" />}
              <SiteOnly site={site.id} as="span">
                <span class="current">目前選擇</span>
              </SiteOnly>
            </div>
            <p class="summary">{site.摘要}</p>
            <div class="chips">
              {MODES.map((mode) => (
                <span class="mode">
                  <span class="mode-label">{MODE_LABEL[mode]}</span>
                  {KEY_COLORS.map(({ label, token }) => (
                    <span
                      class="chip"
                      style={`background:${site[mode][token]}`}
                      title={`${MODE_LABEL[mode]} ${label} ${site[mode][token]}`}
                    >
                      <span class="sr-only">
                        {MODE_LABEL[mode]}
                        {label} {site[mode][token]}
                      </span>
                    </span>
                  ))}
                </span>
              ))}
            </div>
            <a class="detail" href={sitePageUrl(site)}>
              顏色與說明<span class="sr-only">：{site.名稱}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="sample" aria-labelledby="tc-theme-sample-title">
    <div class="sample-head">
      <h2 id="tc-theme-sample-title">
        {SITE_THEMES.map((s) => <SiteOnly site={s.id} as="span">{siteLabel(s)}</SiteOnly>)}
      </h2>
      <p>
        用<a href={templateUrl(sample)}>{sample.名稱}範本</a
        >當樣本：同一頁、同樣的元件，只換成這個網站主題的顏色。淺色／深色用頁首的色彩模式按鈕（月亮／太陽）切換。
      </p>
    </div>
    <TemplateFrame id={sample.id} interactive={false} label={`樣本頁面：${sample.名稱}範本`} />
  </section>
</div>

<style>
  .tc-theme-browser {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: start;
  }
  .list-panel {
    display: flex;
    flex-direction: column;
    max-block-size: 28rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 16px;
    background-color: var(--tc-handbook-panel);
    overflow: hidden;
  }
  @media (min-width: 64rem) {
    .tc-theme-browser {
      grid-template-columns: 18rem minmax(0, 1fr);
    }
    .list-panel {
      position: sticky;
      inset-block-start: calc(var(--sl-nav-height) + 1rem);
      max-block-size: calc(100vh - var(--sl-nav-height) - 2rem);
    }
  }
  .list-head {
    padding: 1.25rem 1.25rem 0.75rem;
  }
  .list-head h2,
  .sample-head h2 {
    margin: 0 0 0.4rem;
    color: var(--sl-color-white);
    font-size: var(--hb-text-category);
    font-weight: 600;
    line-height: var(--hb-line-height-headings);
  }
  .list-head p,
  .sample-head p {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: var(--hb-text-body);
    line-height: var(--hb-line-height);
  }
  .sample-head a {
    color: var(--sl-color-text-accent);
  }
  .sites {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0.5rem 1rem 1rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    list-style: none;
  }
  .site {
    position: relative;
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 12px;
    background-color: var(--sl-color-black);
  }
  .site:hover {
    border-color: var(--sl-color-gray-3);
  }
  .site-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.45rem;
  }
  .apply {
    color: var(--sl-color-white);
    font-weight: 700;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  /* 整張卡片都可以點（套用網站主題）；「顏色與說明」連結疊在上面，可以單獨點。 */
  .apply::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 12px;
  }
  .apply:focus-visible {
    outline: none;
  }
  .apply:focus-visible::after {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .current {
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    background: var(--sl-color-accent-high);
    color: var(--sl-color-black);
    font-size: var(--hb-text-label);
    font-weight: 600;
  }
  .summary {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: var(--hb-text-body);
    line-height: var(--hb-line-height);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
  }
  .mode {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .mode-label {
    margin-inline-end: 0.15rem;
    color: var(--sl-color-gray-3);
    font-size: var(--hb-text-label);
  }
  .chip {
    inline-size: 1.1rem;
    block-size: 1.1rem;
    border-radius: 0.3rem;
    border: 1px solid rgba(127, 127, 127, 0.55);
  }
  .detail {
    position: relative;
    z-index: 1;
    justify-self: start;
    color: var(--sl-color-text-accent);
    font-size: var(--hb-text-ui);
  }
  .detail:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .sample {
    display: grid;
    gap: 1rem;
    min-inline-size: 0;
  }
</style>

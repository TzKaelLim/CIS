---
// 手機選單裡的「主題」下拉選單（頁首用的是 SiteMenu.astro 的圖示按鈕和選單）。
// 選項由 SITE_THEMES 產生，新增主題就會多一個選項。
//
// 狀態放在 <html data-site="…">。第一次繪製前由 <head> 裡的 script 設好
// （src/data/site-selection.ts 的 siteInitScript）；這裡只負責讓選單顯示同一個值，
// 讀者改選時交給 src/scripts/site-choice.ts 套用。沒有 JavaScript 時選單停在預設主題，
// 頁面也顯示預設主題。它只改變手冊「展示」的內容（色票、範例），不改變手冊本身的外觀。
import { Icon } from '@astrojs/starlight/components';
import { DEFAULT_SITE, SITE_THEMES, siteLabel } from '../../data/site-themes';
import { SITE_STORAGE_KEY, SITE_URL_PARAM } from '../../data/site-selection';
---

<tc-site-select
  data-storage-key={SITE_STORAGE_KEY}
  data-url-param={SITE_URL_PARAM}
  data-site-ids={SITE_THEMES.map((site) => site.id).join(',')}
>
  <label class="site-select">
    <span class="label-text">主題</span>
    <span class="control">
      <select autocomplete="off">
        {
          SITE_THEMES.map((site) => (
            <option value={site.id} selected={site.id === DEFAULT_SITE.id}>
              {siteLabel(site)}
            </option>
          ))
        }
      </select>
      <Icon name="down-caret" class="caret" />
    </span>
  </label>
</tc-site-select>

<script>
  import { applySite, currentSite, onSiteChange } from '../../scripts/site-choice';

  /** 讓頁面上所有主題下拉選單都顯示 <html data-site> 的值。 */
  function syncSelects(): void {
    const current = currentSite();
    document.querySelectorAll<HTMLSelectElement>('tc-site-select select').forEach((select) => {
      if (current && Array.from(select.options).some((o) => o.value === current)) {
        select.value = current;
      }
    });
  }

  class TcSiteSelect extends HTMLElement {
    connectedCallback() {
      const select = this.querySelector('select');
      if (!select) return;
      syncSelects();
      select.addEventListener('change', () => applySite(select.value));
    }
  }

  onSiteChange(syncSelects);
  customElements.define('tc-site-select', TcSiteSelect);
</script>

<style>
  tc-site-select {
    display: block;
    min-inline-size: 0;
    max-inline-size: 100%;
  }
  .site-select {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-inline-size: 0;
    color: var(--sl-color-gray-1);
  }
  .label-text {
    flex: 0 0 auto;
    font-size: var(--hb-text-ui);
    white-space: nowrap;
  }
  .control {
    position: relative;
    display: flex;
    align-items: center;
    min-inline-size: 0;
  }
  select {
    appearance: none;
    min-inline-size: 0;
    /* 名稱太長時截斷並加上「…」；完整名稱在展開的清單裡看得到。 */
    inline-size: 11rem;
    max-inline-size: 100%;
    padding-block: 0.35rem;
    padding-inline: 0.6rem 1.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.4rem;
    background-color: transparent;
    color: inherit;
    font: inherit;
    font-size: var(--hb-text-ui);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    cursor: pointer;
  }
  select:hover {
    border-color: var(--sl-color-gray-3);
  }
  select:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  option {
    background-color: var(--sl-color-bg-nav);
    color: var(--sl-color-gray-1);
  }
  .control :global(.caret) {
    position: absolute;
    inset-inline-end: 0.35rem;
    font-size: var(--hb-text-icon);
    pointer-events: none;
  }
  /* 手機選單裡空間比較寬，選單可以拉長。 */
  @media (max-width: 49.99rem) {
    tc-site-select {
      flex: 1 1 100%;
    }
    .control {
      flex: 1 1 auto;
    }
    select {
      inline-size: 100%;
    }
  }
</style>

---
// 元件頁標題下方的「分類 · 英文名」，資料來自元件目錄。
import { getCategory, getComponent } from '../../prototype/component-catalog';

interface Props {
  id: string;
}

const entry = getComponent(Astro.props.id);
const category = getCategory(entry.category);
---

<p class="tc-component-meta not-content">
  <a href={`/components/#category-${category.id}`}>{category.名稱}</a>
  <span aria-hidden="true">·</span>
  <span lang="en">{entry.英文名}</span>
</p>

<style>
  .tc-component-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--sl-color-gray-5);
    text-underline-offset: 0.2em;
  }
  a:hover {
    color: var(--sl-color-white);
  }
</style>

---
// 設計示範：一個「固定配色」的範例外框。顏色寫成外框上的 --p-* 變數（解析好的色碼），
// 所以手冊本身切換亮暗模式時，範例畫面不會跟著變。
import { MODE_LABEL, getSite, sampleVars, type Mode } from '../../prototype/site-themes';

interface Props {
  siteId: string;
  mode: Mode;
}

const { siteId, mode } = Astro.props;
const site = getSite(siteId);
const label = `${site.簡稱}・${MODE_LABEL[mode]}`;
---

<figure class="sample-frame not-content" data-sample-site={site.id} data-mode={mode}>
  <figcaption class="label">
    <span class="dot" style={`background:${site[mode]['brand.primary']}`}></span>
    {label}
    {site.isDemo && <span class="demo">示意</span>}
  </figcaption>
  <div class="frame" style={`${sampleVars(site, mode)};color-scheme:${mode}`}>
    <slot />
  </div>
</figure>

<style>
  .sample-frame {
    margin: 0;
    min-inline-size: 0;
  }
  .label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-block-end: 0.4rem;
    font-size: var(--hb-text-label);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .dot {
    inline-size: 0.7rem;
    block-size: 0.7rem;
    border-radius: 50%;
    border: 1px solid rgba(127, 127, 127, 0.5);
  }
  .demo {
    font-size: var(--hb-text-label);
    font-weight: 500;
    padding: 0.05rem 0.4rem;
    border-radius: 999px;
    border: 1px dashed var(--sl-color-gray-3);
    color: var(--sl-color-gray-2);
  }
  .frame {
    /* 外框顏色固定為中灰，在手冊淺色或深色頁面上都看得見。 */
    border: 1px solid rgba(127, 127, 127, 0.55);
    border-radius: 0.6rem;
    overflow: hidden;
    background: var(--p-surface-subtle);
    color: var(--p-text);
    font-size: var(--hb-sample-text);
    line-height: var(--hb-line-height);
  }
</style>

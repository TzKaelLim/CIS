---
// 設計示範：用 Starlight 內建分頁，一個網站一個分頁，顯示按鈕在各網站的樣子。
// syncKey 讓同一個網站的分頁在所有頁面同步（選了環保網，其他頁也停在環保網）。
import { Tabs, TabItem } from '@astrojs/starlight/components';
import ButtonSamples from './ButtonSamples.astro';
import { SITE_THEMES } from '../../prototype/site-themes';
---

<Tabs syncKey="site-theme">
  {
    SITE_THEMES.map((site) => (
      <TabItem label={site.isDemo ? `${site.名稱}（示意）` : site.名稱}>
        <ButtonSamples siteId={site.id} />
      </TabItem>
    ))
  }
</Tabs>

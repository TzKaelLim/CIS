---
// 設計示範：一個網站主題的迷你網頁，淺色、深色並排（窄螢幕時上下排）。
// 一次只畫一個網站；要跟著頁首選單變，請包在 PerSite 裡。
import SampleUI from './SampleUI.astro';
import { MODES, getSite } from '../../prototype/site-themes';

interface Props {
  siteId: string;
}

const site = getSite(Astro.props.siteId);
---

<div class="gallery not-content">
  <div class="grid">
    {MODES.map((mode) => <SampleUI siteId={site.id} mode={mode} />)}
  </div>
</div>

<style>
  .gallery {
    container-type: inline-size;
    margin-block: 1.25rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    align-items: start;
  }
  @container (max-width: 460px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

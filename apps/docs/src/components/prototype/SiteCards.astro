---
// 設計示範：總覽頁的「所有網站主題」卡片。卡片由 SITE_THEMES 產生、自動換行排列，
// 網站再多（例如 20 個）也只是多幾列，不會變成一欄一個網站的寬表格。
// 目前選擇的網站：卡片加外框（data-site-card）並顯示「目前選擇」（SiteOnly），
// 兩者的 CSS 都在 <head> 裡由網站清單產生。
import { Badge } from '@astrojs/starlight/components';
import SiteOnly from './SiteOnly.astro';
import {
  MODES,
  MODE_LABEL,
  SITE_THEMES,
  sitePageUrl,
  type TokenName,
} from '../../prototype/site-themes';
import { SITE_URL_PARAM } from '../../prototype/site-selection';

const KEY_COLORS: { label: string; token: TokenName }[] = [
  { label: '主色', token: 'brand.primary' },
  { label: '品牌底色', token: 'brand.surface' },
  { label: '文字', token: 'text.default' },
  { label: '背景', token: 'surface.default' },
];
---

<ul class="site-cards not-content" aria-label="所有網站主題">
  {
    SITE_THEMES.map((site) => (
      <li class="card" data-site-card={site.id}>
        <div class="head">
          <span class="name">{site.名稱}</span>
          {site.isDefault && <Badge text="預設" variant="note" />}
          {site.isDemo && <Badge text="示意" variant="caution" />}
          <SiteOnly site={site.id} as="span">
            <span class="current">目前選擇</span>
          </SiteOnly>
        </div>
        <p class="summary">{site.摘要}</p>
        <dl class="chips">
          {MODES.map((mode) => (
            <div class="mode-row">
              <dt>{MODE_LABEL[mode]}</dt>
              <dd>
                {KEY_COLORS.map(({ label, token }) => (
                  <span
                    class="chip"
                    style={`background:${site[mode][token]}`}
                    title={`${label} ${site[mode][token]}`}
                  >
                    <span class="sr-only">
                      {label} {site[mode][token]}
                    </span>
                  </span>
                ))}
              </dd>
            </div>
          ))}
        </dl>
        <div class="links">
          <a href={sitePageUrl(site)}>
            查看<span class="sr-only">{site.名稱}</span>
          </a>
          <a href={`?${SITE_URL_PARAM}=${site.id}`}>
            套用到手冊<span class="sr-only">：{site.名稱}</span>
          </a>
        </div>
      </li>
    ))
  }
</ul>
<p class="legend">
  色塊依序是：{KEY_COLORS.map((c) => c.label).join('、')}。把滑鼠移到色塊上可以看到色碼。
</p>

<style>
  .site-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 0.85rem;
    margin: 1rem 0 0.4rem;
    padding: 0;
    list-style: none;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.6rem;
    min-inline-size: 0;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.45rem;
  }
  .name {
    font-weight: 700;
    color: var(--sl-color-white);
    overflow-wrap: anywhere;
  }
  .current {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    /* accent-high 和 black 在淺色、深色手冊裡都是一深一淺，字一定看得清楚。 */
    background: var(--sl-color-accent-high);
    color: var(--sl-color-black);
  }
  .summary {
    margin: 0;
    font-size: 0.82rem;
    color: var(--sl-color-gray-2);
  }
  .chips {
    display: grid;
    gap: 0.3rem;
    margin: 0;
  }
  .mode-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  dt {
    inline-size: 2.2rem;
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
  }
  dd {
    display: flex;
    gap: 0.3rem;
    margin: 0;
  }
  .chip {
    inline-size: 1.4rem;
    block-size: 1.4rem;
    border-radius: 0.3rem;
    /* 中灰邊線：白色或近黑的色塊在任何頁面底色上都看得出邊界。 */
    border: 1px solid rgba(127, 127, 127, 0.55);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-block-start: auto;
    padding-block-start: 0.25rem;
    font-size: 0.85rem;
  }
  .links a {
    color: var(--sl-color-text-accent);
  }
  .legend {
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
  }
</style>

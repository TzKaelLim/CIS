{
  "extends": "./tsconfig/nextjs.json",
  "compilerOptions": {
    "strict": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/core-dist": ["../../packages/core/dist"],
      "@/core": ["../../packages/core/index.ts"],
      "@/core/*": ["../../packages/core/*"],
      "@tzuchi/tceditor": ["../../packages/core/index.ts"],
      "@/plugin-heading-analyzer": ["../../packages/plugin-heading-analyzer"],
      "@/plugin-heading-analyzer/*": [
        "../../packages/plugin-heading-analyzer/*"
      ],
      "@tiptap/static-renderer/json/react": [
        "../../packages/core/node_modules/@tiptap/static-renderer/dist/json/react/index"
      ]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}

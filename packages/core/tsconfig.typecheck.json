{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "exclude": [
    "dist",
    "build",
    "node_modules",
    "**/__tests__/**",
    "**/__helpers__/**",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "tsup.config.ts",
    "jest.config.ts"
  ]
}

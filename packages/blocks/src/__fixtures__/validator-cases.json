        {
          "type": "Image",
          "props": {
            "id": "Image-1",
            "image": { "assetId": "demo-3", "alt": "", "decorative": true }
          }
        }
      ]
    },
    "expect": { "ok": true }
  },
  {
    "name": "按鈕文字 40 個中文字",
    "input": {
      "root": { "props": {} },
      "content": [
        {
          "type": "Button",
          "props": {
            "id": "Button-1",
            "label": "字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字",
            "href": "/register"
          }
        }
      ]
    },
    "expect": { "ok": true }
  },
  {
    "name": "按鈕文字 41 個中文字",
    "input": {
      "root": { "props": {} },
      "content": [
        {
          "type": "Button",
          "props": {
            "id": "Button-1",
            "label": "字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字字",
            "href": "/register"
          }
        }
      ]
    },
    "expect": {
      "ok": false,
      "errors": [
        { "code": "invalid_value", "pathText": "content[0].props.label" }
      ]
    }
  },
  {
    "name": "javascript: 連結",
    "input": {
      "root": { "props": {} },
      "content": [
        {
          "type": "Button",
          "props": {
            "id": "Button-1",
            "label": "立即報名",
            "href": "javascript:alert(1)"
          }
        }
      ]
    },
    "expect": {
      "ok": false,
      "errors": [{ "code": "unsafe_href", "pathText": "content[0].props.href" }]
    }
  },
  {
    "name": "卡片的選填連結是 data: 網址",
    "input": {
      "root": { "props": {} },
      "content": [
        {
          "type": "Card",
          "props": {
            "id": "Card-1",
            "href": "data:text/html,<script>alert(1)</script>"
          }
        }
      ]
    },
    "expect": {
      "ok": false,
      "errors": [{ "code": "unsafe_href", "pathText": "content[0].props.href" }]
    }
  },
  {
    "name": "富文字是舊的 HTML 字串",
    "input": {
      "root": { "props": {} },
      "content": [
        {
          "type": "Paragraph",
          "props": { "id": "Paragraph-1", "body": "<p>舊網站的內文</p>" }

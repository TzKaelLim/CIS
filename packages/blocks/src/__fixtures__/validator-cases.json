  {
    "name": "props 有 __proto__",
    "input": {
      "root": { "props": {} },
      "content": [
        {
          "type": "Button",
          "props": {
            "id": "Button-1",
            "label": "立即報名",
            "href": "/register",
            "__proto__": { "polluted": true }
          }
        }
      ]
    },
    "expect": {
      "ok": false,
      "errors": [
        { "code": "unknown_prop", "pathText": "content[0].props.__proto__" }
      ]
    }
  },
  {
    "name": "清單項目有 constructor",
    "input": {
      "root": { "props": {} },
      "content": [
        {
          "type": "TagList",
          "props": {
            "id": "TagList-1",
            "tags": [

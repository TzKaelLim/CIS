[
  {
    "name": "完整的活動頁：8 種區塊與巢狀放置區",
    "input": {
      "root": {
        "props": {
          "title": "淨灘活動",
          "description": "每月第一個週六上午在福隆海灘集合。"
        }
      },
      "content": [
        {
          "type": "Heading",
          "props": {
            "id": "Heading-1",
            "text": "2026 年淨灘活動",
            "level": "h1",
            "align": "center"
          }
        },
        {
          "type": "Paragraph",
          "props": {
            "id": "Paragraph-1",
            "body": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "attrs": { "textAlign": null },
                  "content": [{ "type": "text", "text": "一起守護海岸。" }]
                }
              ]
            }
          }
        },
        {
          "type": "Section",
          "props": {
            "id": "Section-1",
            "background": "secondary",
            "paddingY": "64",
            "content": [
              {
                "type": "Columns",
                "props": {
                  "id": "Columns-1",
                  "gap": "32",
                  "columns": [
                    {
                      "content": [
                        {
                          "type": "Card",
                          "props": {
                            "id": "Card-1",
                            "title": "報名方式",
                            "summary": "線上報名或電話報名。",
                            "href": "",
                            "content": [
                              {
                                "type": "Paragraph",
                                "props": {
                                  "id": "Paragraph-2",
                                  "body": {
                                    "type": "doc",
                                    "content": [
                                      {
                                        "type": "paragraph",
                                        "attrs": { "textAlign": null },
                                        "content": [
                                          {
                                            "type": "text",
                                            "text": "名額有限。"
                                          }
                                        ]
                                      }
                                    ]
                                  }
                                }
                              },
                              {
                                "type": "Button",
                                "props": {
                                  "id": "Button-1",
                                  "label": "立即報名",
                                  "href": "/register",
                                  "size": "sm"
                                }
                              },
                              {
                                "type": "Button",
                                "props": {
                                  "id": "Button-2",
                                  "label": "電話報名",
                                  "href": "tel:+886-2-1234-5678",
                                  "variant": "outline"
                                }
                              }
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "content": [
                        {
                          "type": "Image",
                          "props": {
                            "id": "Image-1",
                            "image": {
                              "assetId": "demo-1",
                              "alt": "志工在海灘上撿拾垃圾",
                              "decorative": false
                            },
                            "ratio": "16:9",
                            "caption": "去年的活動照片"
                          }
                        },
                        {
                          "type": "TagList",
                          "props": {
                            "id": "TagList-1",
                            "tags": [{ "label": "環保" }, { "label": "戶外" }]
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "type": "Button",
          "props": {
            "id": "Button-3",
            "label": "寫信詢問",
            "href": "mailto:volunteer@example.org",
            "fullWidth": true
          }
        }
      ]
    },
    "expect": { "ok": true }
  },
  {
    "name": "空白頁面",
    "input": { "root": { "props": {} }, "content": [] },
    "expect": { "ok": true }
  },
  {
    "name": "編輯器送出的格式：zones 為空物件、uuid id、富文字不含 attrs",
    "input": {
      "root": { "props": { "title": "未命名頁面", "description": "" } },
      "content": [
        {
          "type": "Paragraph",
          "props": {
            "id": "Paragraph-6f1c2b9e-8d4a-4c6b-9f0e-1a2b3c4d5e6f",
            "body": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [{ "type": "text", "text": "請輸入內文。" }]
                }
              ]
            },
            "align": "start"
          }
        }
      ],
      "zones": {}
    },
    "expect": { "ok": true }
  },
  {
    "name": "多欄的一欄沒有 content、卡片沒有 content",
    "input": {
      "root": { "props": {} },
      "content": [
        {
          "type": "Columns",
          "props": { "id": "Columns-1", "columns": [{}, { "content": [] }] }
        },
        { "type": "Card", "props": { "id": "Card-1", "title": "卡片" } }
      ]
    },
    "expect": { "ok": true }
  },
  {
    "name": "節點的 readOnly 會被移除",
    "input": {
      "root": { "props": {} },
      "content": [
        {
          "type": "Heading",
          "props": { "id": "Heading-1" },
          "readOnly": { "text": true }
        }
      ]
    },
    "expect": { "ok": true }
  },
  {
    "name": "純裝飾圖片不需要替代文字",

{
  "name": "@tzuchi/tceditor-blocks",
  "version": "0.1.0",
  "private": true,
  "description": "Tzu Chi demo blocks for tceditor: specs, views and editor config",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./specs": "./src/specs.ts",
    "./validator": "./src/validator.ts"
  },
  "scripts": {
    "lint": "eslint \"**/*.ts*\"",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@heroui/styles": "link:../../vendor/uikit/heroui/styles",
    "@tzuchi/tceditor": "workspace:*",
    "@tzuchi/tceditor-spec": "workspace:*",
    "@tzuchi/tokens": "link:../../vendor/uikit/packages/tokens",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "24.13.2",
    "ajv": "8.20.0",
    "eslint": "9.39.4",
    "eslint-config-custom": "workspace:*",
    "jest": "29.7.0",
    "ts-jest": "29.4.9",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}

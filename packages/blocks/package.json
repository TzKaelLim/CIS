    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.2",
    "@types/prettier": "2.7.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "ajv": "8.20.0",
    "eslint": "9.39.4",
    "eslint-config-custom": "workspace:*",
    "jest": "29.7.0",
    "jest-environment-jsdom": "30.4.1",
    "prettier": "2.8.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "ts-jest": "29.4.9",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },

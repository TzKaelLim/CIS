    "./validator": "./src/validator.ts",
    "./render": "./src/render-config.tsx",
    "./editor": "./src/editor-config.tsx",
    "./assets": "./src/asset-source.ts",
    "./demo-assets": "./src/demo-assets.ts",
    "./styles.css": "./styles.css",
    "./generated/catalog.json": "./generated/catalog.json",
    "./generated/page-shell.draft07.json": "./generated/page-shell.draft07.json"
  },
  "scripts": {

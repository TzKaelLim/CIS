{
  "font": {
    "family": {
      "base": {
        "$type": "fontFamily",
        "$value": [
          "Noto Sans TC",
          "system-ui",
          "-apple-system",
          "PingFang TC",
          "Microsoft JhengHei",
          "sans-serif"
        ]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "46": { "$value": "46px" },
      "34": { "$value": "34px" },
      "26": { "$value": "26px" },
      "24": { "$value": "24px" },
      "20": { "$value": "20px" },
      "16": { "$value": "16px" }
    }
  },
  "line-height": {
    "$type": "number",
    "tight": { "$value": 1.3 },
    "snug": { "$value": 1.4 },
    "normal": { "$value": 1.5 },
    "relaxed": { "$value": 1.6 }
  }
}

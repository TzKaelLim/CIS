{
  "article-card": {
    "bg": {
      "$type": "color",
      "$value": "{color.surface.default}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.lg}"
    },
    "elevation": {
      "$type": "shadow",
      "$value": "{elevation.1}"
    },
    "elevation-hover": {
      "$type": "shadow",
      "$value": "{elevation.3}"
    },
    "headline-fg": {
      "$type": "color",
      "$value": "{color.brand.primary}"
    },
    "headline-fg-hover": {
      "$type": "color",
      "$value": "{color.brand.primary-hover}"
    },
    "excerpt-fg": {
      "$type": "color",
      "$value": "{color.text.default}"
    },
    "meta-fg": {
      "$type": "color",
      "$value": "{color.text.muted}"
    },
    "overlay-bg": {
      "$type": "color",
      "$value": "rgba(0, 0, 0, 0.55)"
    },
    "focus-ring-color": {
      "$type": "color",
      "$value": "{color.border.focus}"
    }
  }
}

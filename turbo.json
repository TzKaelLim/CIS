{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.mjs"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@tzuchi/tceditor#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/LICENSE",
        "$TURBO_ROOT$/NOTICE",
        "$TURBO_ROOT$/packages/plugin-heading-analyzer/package.json",
        "$TURBO_ROOT$/packages/plugin-heading-analyzer/LICENSE",
        "$TURBO_ROOT$/packages/plugin-heading-analyzer/NOTICE"
      ]
    },
    "@tzuchi/tceditor-blocks#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vendor/uikit/**",
        "$TURBO_ROOT$/apps/showcase/public/demo-assets/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
